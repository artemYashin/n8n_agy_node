{
  "name": "Agy \u2014 Telegram AI Image Agent",
  "nodes": [
    {
      "name": "Telegram Trigger",
      "id": "telegram-trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      }
    },
    {
      "name": "AI Agent",
      "id": "ai-agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message.text || $json.message.caption || 'Ask the user to send a text request.' }}",
        "options": {
          "systemMessage": "You are a helpful Telegram assistant. When the user asks to create an image, call generate_and_send_image with a detailed visual prompt. The tool sends the image to the originating chat itself. After success, confirm briefly; do not call it again for the same request or output image URLs/base64. If the tool fails, explain the failure without claiming delivery. Never invent tool results.",
          "maxIterations": 5
        }
      }
    },
    {
      "name": "OpenAI Chat Model",
      "id": "openai-chat-model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        220,
        240
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gemini-3.8-flash-medium"
        },
        "responsesApiEnabled": false,
        "options": {
          "timeout": 300000,
          "maxRetries": 0
        }
      }
    },
    {
      "name": "generate_and_send_image",
      "id": "generate_and_send_image",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 2.2,
      "position": [
        520,
        240
      ],
      "parameters": {
        "description": "Generate one image from a detailed visual prompt and send it to the current Telegram chat. Call for requests to draw or create an image. Returns only delivery status, not image bytes.",
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": "SELECT_IMAGE_WORKFLOW"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "prompt": "={{ $fromAI('prompt', 'Detailed visual description of the image the user wants to generate', 'string') }}",
            "chat_id": "={{ String($('Telegram Trigger').first().json.message.chat.id) }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "prompt",
              "displayName": "prompt",
              "required": true,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            },
            {
              "id": "chat_id",
              "displayName": "chat_id",
              "required": true,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        }
      }
    },
    {
      "name": "Send Reply",
      "id": "send-reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        760,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Telegram Trigger').first().json.message.chat.id }}",
        "text": "={{ $json.output }}",
        "additionalFields": {
          "appendAttribution": false
        }
      }
    },
    {
      "name": "Setup",
      "id": "setup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -320
      ],
      "parameters": {
        "content": "## Setup\nSelect the same Telegram bot credential on Trigger and Send Reply.\nOpenAI credential: your Agy API key + http://YOUR_SERVER:44455/v1.\nKeep Use Responses API OFF.\nSelect the imported image sub-workflow in generate_and_send_image.\nKeep chat_id mapped to Telegram Trigger, not $fromAI.\nSave/publish the sub-workflow as required by your n8n version, then activate this workflow.",
        "height": 280,
        "width": 760
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "generate_and_send_image": {
      "ai_tool": [
        [
          {
            "node": "AI Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "Send Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 360
  },
  "active": false,
  "pinData": {}
}
